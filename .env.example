# Where content, users and progress come from.
#   json  = static files in src/content (default, no database needed)
#   mongo = MongoDB (run `npm run db:up` and `npm run db:seed` first)
DATA_SOURCE=json

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=software_engineers_hub

# Secret used to sign the login cookie. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
