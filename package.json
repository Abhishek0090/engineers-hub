{
  "name": "software-engineers-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Software Engineers Hub: chapter-wise full stack study and interview prep, Duolingo style",
  "author": "Abhishek Pal",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "db:up": "docker compose up -d mongo",
    "db:seed": "node scripts/seed-mongo.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "share": "node scripts/build-docs.mjs && node scripts/make-share.mjs",
    "docs": "node scripts/build-docs.mjs"
  },
  "dependencies": {
    "mongodb": "^7.9.0",
    "next": "^16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
